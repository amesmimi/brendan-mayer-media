---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import { PHOTO_QUALITY } from '../lib/images';

// Background photo: the first image in src/assets/site/ with "contact" in its name (optional).
const backgrounds = import.meta.glob<{ default: ImageMetadata }>('/src/assets/site/*contact*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const background = Object.values(backgrounds)[0]?.default;
const reverse = (s: string) => [...s].reverse().join('');
---

<!--
  Edge-to-edge photo band; the email address is the call to action.
  On phones the band is taller than it is wide, so the photo is drawn far wider than the screen; the 1300px size hint
  makes phones load a file big enough for that instead of one sized to the screen width.
-->
<section class="contact protect" id="contact" aria-labelledby="contact-title">
  {background && (
    <Picture
      class="bg"
      src={background}
      alt=""
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000, 2800, 3200]}
      quality={PHOTO_QUALITY}
      sizes="(max-width: 900px) 1300px, 100vw"
      loading="lazy"
      draggable="false"
    />
  )}
  <div class="wrap inner">
    <h2 id="contact-title">Got an event coming up?</h2>
    <a
      class="email"
      href="#contact"
      data-mailto="Booking enquiry"
      data-email-text
      data-email-user={reverse(site.email.user)}
      data-email-domain={reverse(site.email.domain)}
    >
      <noscript>Turn on JavaScript to see the email address, or message {site.instagram.handle} on Instagram.</noscript>
    </a>
    <p class="intro">
      Send the date, venue, type of event, what the photos are for and your budget, and I'll get back to you within two
      business days.
    </p>
    <div class="meta">
      <button type="button" data-copy-email aria-describedby="copy-status">
        Copy email
      </button>
      <a class="insta" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
        </svg>
        {site.instagram.handle}
      </a>
      <span class="area">{site.serviceArea}</span>
    </div>
    <p class="status" id="copy-status" role="status"></p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-top: clamp(96px, 10vw, 128px);
    background: var(--charcoal-950);
    color: var(--cream);
  }

  .contact :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
    z-index: -2;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Shades the text side; the photo shows through on the right */
    background: linear-gradient(90deg, rgb(18 17 16 / 0.8) 0%, rgb(18 17 16 / 0.52) 50%, rgb(18 17 16 / 0.12) 100%);
  }

  /* Tall enough that the whole figure in the smoke photo stays in frame */
  .inner {
    padding-top: clamp(120px, 14.5vw, 210px);
    padding-bottom: clamp(120px, 14.5vw, 210px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  h2 {
    font-size: 56px;
    line-height: 0.95;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(22px, 3vw, 40px);
    line-height: 1.2;
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--amber);
    overflow-wrap: anywhere;
  }

  .email noscript {
    font-family: var(--font-body);
    font-size: var(--text-small);
  }

  .intro {
    max-width: 60ch;
    color: #d2cec4;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 28px;
    font-size: var(--text-small);
  }

  .meta button {
    font: inherit;
    font-weight: 600;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .insta {
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  .insta svg {
    width: 18px;
    height: 18px;
  }

  .email:hover,
  .meta button:hover,
  .insta:hover {
    color: var(--amber);
  }

  .area {
    color: #d2cec4;
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--amber);
    min-height: 1.4em;
    margin-top: -10px;
  }

  @media (max-width: 900px) {
    .contact :global(.bg) {
      object-position: 50% 30%;
    }
    .contact::before {
      background: linear-gradient(180deg, rgb(18 17 16 / 0.62) 0%, rgb(18 17 16 / 0.74) 100%);
    }
    h2 {
      font-size: 44px;
    }
  }
</style>
