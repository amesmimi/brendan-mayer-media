---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { bookingChecklist, site } from '../data/site';

// Background photo: the first image in src/assets/site/ with "contact" in its name (optional).
const backgrounds = import.meta.glob<{ default: ImageMetadata }>('/src/assets/site/*contact*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const background = Object.values(backgrounds)[0]?.default;
const reverse = (s: string) => [...s].reverse().join('');
const checklist = bookingChecklist.map((q) => q.toLowerCase()).join(', ');
---

<section class="section wrap" id="contact" aria-labelledby="contact-title">
  <div class="contact protect">
    {background && (
      <Picture
        class="bg"
        src={background}
        alt=""
        formats={['avif', 'webp']}
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="lazy"
        draggable="false"
      />
    )}
    <div class="heading">
      <p class="eyebrow">Bookings and enquiries</p>
      <h2 id="contact-title">Got a shoot coming up?</h2>
    </div>
    <p class="intro">
      Email me and I'll get back to you within two days.{' '}
      <span>
        <b>Helpful to include:</b> {checklist}.
      </span>
    </p>
    <div class="email-row">
      <span
        class="email"
        data-email-text
        data-email-user={reverse(site.email.user)}
        data-email-domain={reverse(site.email.domain)}
      >
        <noscript>
          Turn on JavaScript to see the email address, or message {site.instagram.handle} on Instagram.
        </noscript>
      </span>
      <button class="btn btn-primary" type="button" data-copy-email aria-describedby="copy-status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2"></rect>
          <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
        </svg>
        Copy email
      </button>
      <a class="btn btn-ghost" href="#contact" data-mailto="Booking enquiry">
        Open in my email app
      </a>
    </div>
    <p class="status" id="copy-status" role="status"></p>
    <div class="meta">
      <a href={site.instagram.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
        </svg>
        {site.instagram.handle}
      </a>
      <span>{site.serviceArea}</span>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
    /* Fills the screen below the header (capped on very tall screens), so "Book a shoot" lands on the whole section */
    min-height: min(calc(100svh - var(--header-height) - 48px), 820px);
    padding: clamp(40px, 6vw, 80px) clamp(22px, 5vw, 72px);
    display: grid;
    align-content: center;
    gap: 24px;
    background: var(--green-950);
  }

  .contact :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    z-index: -2;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(8 32 29 / 0.94) 0%, rgb(8 32 29 / 0.82) 50%, rgb(8 32 29 / 0.4) 100%);
  }

  .heading {
    display: grid;
    gap: 12px;
  }

  h2 {
    font-size: clamp(52px, 8.5vw, 128px);
  }

  .intro {
    max-width: 60ch;
    font-size: clamp(17px, 1.4vw, 20px);
  }

  .intro span {
    color: var(--cream-muted);
  }

  .intro b {
    color: var(--cream);
    font-weight: 600;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(18px, 2.4vw, 26px);
    background: rgb(8 32 29 / 0.6);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    user-select: all;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .email noscript {
    font-family: var(--font-body);
    font-size: var(--text-small);
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--amber);
    min-height: 1.4em;
    margin-top: -8px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: var(--text-small);
  }

  .meta a {
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  .meta a:hover {
    color: var(--amber);
  }

  .meta svg {
    width: 18px;
    height: 18px;
  }
</style>
