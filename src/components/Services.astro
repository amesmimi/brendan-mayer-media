---
import { Picture } from 'astro:assets';
import { services } from '../data/site';
import type { Gallery } from '../lib/galleries';
import { PHOTO_QUALITY, coverSizes, widthsFor } from '../lib/images';
import { url } from '../lib/paths';

interface Props {
  galleries: Gallery[];
}

const { galleries } = Astro.props;

// Each service shows three of its gallery's photos, cropped square: one big, two small stacked beside it.
const rows = await Promise.all(
  services.map(async (service) => {
    const photos = galleries.find((g) => g.slug === service.gallery)?.photos ?? [];
    const picks = service.photos.flatMap(({ file, x = 50 }) => {
      const photo = photos.find((p) => p.file === file);
      if (!photo) console.warn(`[services] ${service.title}: no photo "${file}" in the ${service.gallery} gallery.`);
      return photo ? [{ photo, x: Math.round(x / 5) * 5 }] : [];
    });
    return { ...service, tiles: picks };
  }),
);
---

<section class="wrap services" id="services" aria-label="What I shoot">
  {rows.map((row, i) => (
    <article class:list={['row', { flip: i % 2 === 1 }]} id={row.gallery} aria-labelledby={`service-${row.gallery}`}>
      <div class="mosaic protect">
        {row.tiles.map(({ photo, x }, k) => (
          <div class:list={['tile', { big: k === 0 }, `x-${x}`, photo.focus && `focus-${photo.focus}`]}>
            <Picture
              src={photo.image}
              alt={photo.alt}
              formats={['avif', 'webp']}
              widths={widthsFor(
                photo.image,
                k === 0 ? [500, 800, 1100, 1600, 2000, 2600, 3200] : [300, 500, 800, 1100, 1400, 1800],
              )}
              quality={PHOTO_QUALITY}
              sizes={coverSizes(
                photo.image,
                1,
                k === 0
                  ? '(min-width: 1680px) 790px, (min-width: 900px) 50vw, 66vw'
                  : '(min-width: 1680px) 395px, (min-width: 900px) 25vw, 33vw',
              )}
              loading="lazy"
              draggable="false"
            />
            {photo.caption && (
              <span class="name" aria-hidden="true">
                {photo.caption}
              </span>
            )}
          </div>
        ))}
        {/* Empty squares hold the layout while a service has fewer than three photos */}
        {Array.from({ length: Math.max(0, 3 - row.tiles.length) }, (_, k) => (
          <span class:list={['slot', { big: row.tiles.length + k === 0 }]} aria-hidden="true" />
        ))}
      </div>
      <div class="copy">
        <h2 id={`service-${row.gallery}`}>{row.title}</h2>
        <p>{row.text}</p>
        <a class="more" href={url(`gallery/#${row.gallery}`)} data-astro-prefetch>
          View gallery<span class="visually-hidden">: {row.title}</span>
        </a>
      </div>
    </article>
  ))}
</section>

<style>
  .services {
    display: grid;
    gap: clamp(64px, 7vw, 96px);
  }

  /* Photos take three-quarters of the row; every other row puts them on the right */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(260px, 1fr);
    gap: 40px;
    align-items: end;
  }

  .row.flip {
    grid-template-columns: minmax(260px, 1fr) minmax(0, 3fr);
  }

  .row.flip .mosaic {
    order: 2;
  }

  /* Three equal columns: the big square spans two columns and two rows, so all three are true squares */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    align-items: start;
  }

  .mosaic .tile,
  .mosaic .slot {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--charcoal-950);
  }

  /* The artist or team name fades in over the photo on hover (devices with a mouse) */
  .name {
    position: absolute;
    inset: auto 0 0;
    padding: 28px 14px 12px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--cream);
    background: linear-gradient(transparent, rgb(18 17 16 / 0.75));
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  @media (hover: hover) {
    .tile:hover .name {
      opacity: 1;
    }
  }

  .mosaic .big {
    grid-column: span 2;
    grid-row: span 2;
  }

  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Square crops: each photo's `x` in site.ts sets the left-right position, and its `focus` in the gallery
     file the top-bottom one (classes, since the security policy blocks inline styles) */
  .mosaic :global(img) {
    object-position: var(--x, 50%) var(--y, 50%);
  }
  .focus-top {
    --y: 0%;
  }
  .focus-bottom {
    --y: 85%;
  }
  .x-0 {
    --x: 0%;
  }
  .x-5 {
    --x: 5%;
  }
  .x-10 {
    --x: 10%;
  }
  .x-15 {
    --x: 15%;
  }
  .x-20 {
    --x: 20%;
  }
  .x-25 {
    --x: 25%;
  }
  .x-30 {
    --x: 30%;
  }
  .x-35 {
    --x: 35%;
  }
  .x-40 {
    --x: 40%;
  }
  .x-45 {
    --x: 45%;
  }
  .x-55 {
    --x: 55%;
  }
  .x-60 {
    --x: 60%;
  }
  .x-65 {
    --x: 65%;
  }
  .x-70 {
    --x: 70%;
  }
  .x-75 {
    --x: 75%;
  }
  .x-80 {
    --x: 80%;
  }
  .x-85 {
    --x: 85%;
  }
  .x-90 {
    --x: 90%;
  }
  .x-95 {
    --x: 95%;
  }
  .x-100 {
    --x: 100%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding-bottom: 4px;
  }

  .copy h2 {
    font-size: 56px;
    line-height: 0.95;
  }

  .copy p {
    color: var(--cream-muted);
  }

  .more {
    font-weight: 600;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .more:hover {
    color: var(--amber);
  }

  @media (max-width: 900px) {
    .row,
    .row.flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .row.flip .mosaic {
      order: 0;
    }
  }
</style>
