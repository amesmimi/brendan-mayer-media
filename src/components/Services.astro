---
import { Picture } from 'astro:assets';
import { services } from '../data/site';
import type { Gallery } from '../lib/galleries';
import { widthsFor } from '../lib/images';

interface Props {
  galleries: Gallery[];
}

const { galleries } = Astro.props;
// Each card shows the second photo of its gallery (the first already leads the filmstrip), or the first if it's the only one.
const cards = services.map((service) => {
  const photos = galleries.find((g) => g.slug === service.gallery)?.photos ?? [];
  return { ...service, photo: photos[1] ?? photos[0] };
});
---

<section class="section wrap" id="services" aria-labelledby="services-title">
  <div class="section-head">
    <div class="section-title">
      <p class="eyebrow">Services</p>
      <h2 id="services-title">What I shoot</h2>
    </div>
  </div>
  <div class="services">
    {cards.map((card) => (
      <article class="service">
        {card.photo && (
          <figure class="protect">
            <Picture
              src={card.photo.image}
              alt=""
              formats={['avif', 'webp']}
              widths={widthsFor(card.photo.image, [400, 700])}
              sizes="(min-width: 1240px) 25vw, (min-width: 680px) 50vw, 92vw"
              loading="lazy"
              draggable="false"
            />
          </figure>
        )}
        <div class="body">
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <ul>
            {card.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="ctas">
            <a class="btn btn-primary" href="#contact" data-mailto={`Booking enquiry: ${card.title}`}>
              Book this
            </a>
            <a class="link-arrow" href="#work" data-show-gallery={card.gallery}>
              See examples <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .service {
    background: var(--green-950);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 12px;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  figure {
    margin: 0;
    border-radius: calc(var(--radius-lg) - 8px);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 22px 14px 14px;
    display: grid;
    gap: 14px;
    grid-template-rows: auto auto 1fr auto;
  }

  .body p {
    color: var(--cream-muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: var(--text-small);
    align-content: start;
  }

  li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
    transform: translateY(-2px);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    padding-top: 8px;
  }

  @media (max-width: 1240px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
