---
import { Picture } from 'astro:assets';
import { services } from '../data/site';
import type { Gallery } from '../lib/galleries';
import { PHOTO_QUALITY, coverSizes, viewerImage, widthsFor } from '../lib/images';
import { url } from '../lib/paths';

interface Props {
  galleries: Gallery[];
}

const { galleries } = Astro.props;

// Each service shows three of its gallery's photos, cropped square: one big, two small stacked beside it.
const rows = await Promise.all(
  services.map(async (service) => {
    const photos = galleries.find((g) => g.slug === service.gallery)?.photos ?? [];
    const picks = service.photos.flatMap(({ file, x = 50 }) => {
      const photo = photos.find((p) => p.file === file);
      if (!photo) console.warn(`[services] ${service.title}: no photo "${file}" in the ${service.gallery} gallery.`);
      return photo ? [{ photo, x: Math.round(x / 5) * 5 }] : [];
    });
    const tiles = await Promise.all(
      picks.map(async (pick) => ({ ...pick, large: await viewerImage(pick.photo.image) })),
    );
    return { ...service, tiles };
  }),
);
---

<section class="wrap services" id="services" aria-label="What I shoot">
  {rows.map((row, i) => (
    <article class:list={['row', { flip: i % 2 === 1 }]} id={row.gallery} aria-labelledby={`service-${row.gallery}`}>
      <div class="mosaic protect" data-gallery>
        {row.tiles.map(({ photo, x, large }, k) => (
          <a
            class:list={[{ big: k === 0 }, `x-${x}`]}
            href={large.src}
            data-caption={photo.caption}
            data-pswp-width={large.width}
            data-pswp-height={large.height}
          >
            <Picture
              src={photo.image}
              alt={photo.alt}
              formats={['avif', 'webp']}
              widths={widthsFor(
                photo.image,
                k === 0 ? [500, 800, 1100, 1600, 2000, 2600, 3200] : [300, 500, 800, 1100, 1400, 1800],
              )}
              quality={PHOTO_QUALITY}
              sizes={coverSizes(
                photo.image,
                1,
                k === 0
                  ? '(min-width: 1680px) 790px, (min-width: 900px) 50vw, 66vw'
                  : '(min-width: 1680px) 395px, (min-width: 900px) 25vw, 33vw',
              )}
              loading="lazy"
              draggable="false"
            />
          </a>
        ))}
        {/* Empty squares hold the layout while a service has fewer than three photos */}
        {Array.from({ length: Math.max(0, 3 - row.tiles.length) }, (_, k) => (
          <span class:list={['slot', { big: row.tiles.length + k === 0 }]} aria-hidden="true" />
        ))}
      </div>
      <div class="copy">
        <h2 id={`service-${row.gallery}`}>{row.title}</h2>
        <p>{row.text}</p>
        <a class="more" href={url(`gallery/#${row.gallery}`)} data-astro-prefetch>
          View gallery<span class="visually-hidden">: {row.title}</span>
        </a>
      </div>
    </article>
  ))}
</section>

<style>
  .services {
    display: grid;
    gap: clamp(64px, 7vw, 96px);
  }

  /* Photos take three-quarters of the row; every other row puts them on the right */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(260px, 1fr);
    gap: 40px;
    align-items: end;
  }

  .row.flip {
    grid-template-columns: minmax(260px, 1fr) minmax(0, 3fr);
  }

  .row.flip .mosaic {
    order: 2;
  }

  /* Three equal columns: the big square spans two columns and two rows, so all three are true squares */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    align-items: start;
  }

  .mosaic a,
  .mosaic .slot {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--charcoal-950);
  }

  .mosaic .big {
    grid-column: span 2;
    grid-row: span 2;
  }

  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Horizontal crop from each photo's `x` in site.ts (classes, since the security policy blocks inline styles) */
  .x-0 :global(img) {
    object-position: 0% 50%;
  }
  .x-5 :global(img) {
    object-position: 5% 50%;
  }
  .x-10 :global(img) {
    object-position: 10% 50%;
  }
  .x-15 :global(img) {
    object-position: 15% 50%;
  }
  .x-20 :global(img) {
    object-position: 20% 50%;
  }
  .x-25 :global(img) {
    object-position: 25% 50%;
  }
  .x-30 :global(img) {
    object-position: 30% 50%;
  }
  .x-35 :global(img) {
    object-position: 35% 50%;
  }
  .x-40 :global(img) {
    object-position: 40% 50%;
  }
  .x-45 :global(img) {
    object-position: 45% 50%;
  }
  .x-55 :global(img) {
    object-position: 55% 50%;
  }
  .x-60 :global(img) {
    object-position: 60% 50%;
  }
  .x-65 :global(img) {
    object-position: 65% 50%;
  }
  .x-70 :global(img) {
    object-position: 70% 50%;
  }
  .x-75 :global(img) {
    object-position: 75% 50%;
  }
  .x-80 :global(img) {
    object-position: 80% 50%;
  }
  .x-85 :global(img) {
    object-position: 85% 50%;
  }
  .x-90 :global(img) {
    object-position: 90% 50%;
  }
  .x-95 :global(img) {
    object-position: 95% 50%;
  }
  .x-100 :global(img) {
    object-position: 100% 50%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding-bottom: 4px;
  }

  .copy h2 {
    font-size: 56px;
    line-height: 0.95;
  }

  .copy p {
    color: var(--cream-muted);
  }

  .more {
    font-weight: 600;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .more:hover {
    color: var(--amber);
  }

  @media (max-width: 900px) {
    .row,
    .row.flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .row.flip .mosaic {
      order: 0;
    }
  }
</style>
