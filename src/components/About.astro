---
import { Picture } from 'astro:assets';
import portrait from '../assets/about/brendan.jpg';
import { about } from '../data/site';
import { PHOTO_QUALITY, coverSizes, widthsFor } from '../lib/images';
import { url } from '../lib/paths';

const artists = new Intl.ListFormat('en-CA', { type: 'conjunction' }).format(about.artists);
---

<section class="wrap about" id="about" aria-labelledby="about-title">
  <figure class="photo protect">
    <Picture
      src={portrait}
      alt="Brendan Mayer smiling, wearing a black toque and tan jacket"
      formats={['avif', 'webp']}
      widths={widthsFor(portrait, [500, 800, 1100, 1400, 2000, 2600, 3200])}
      quality={PHOTO_QUALITY}
      sizes={coverSizes(portrait, 5 / 6, '(min-width: 1680px) 700px, (min-width: 900px) 42vw, 100vw')}
      loading="lazy"
      draggable="false"
    />
  </figure>
  <div class="body">
    <h2 id="about-title">{about.heading}</h2>
    {about.paragraphs.map((p, i) => (
      <p class:list={{ lead: i === 0 }}>{p}</p>
    ))}
    <p class="artists">I've photographed {artists}.</p>
    {/* Booking lives in the nav's "Work with me"; the CV link shows once there's a CV to share */}
    {about.cvFile && (
      <a class="cv" href={url(about.cvFile)} download>
        Download CV (PDF)
      </a>
    )}
  </div>
</section>

<style>
  .about {
    margin-top: clamp(96px, 10vw, 128px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
  }

  .photo {
    margin: 0;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background: var(--charcoal-950);
  }

  /* Side by side with the text: never taller than the screen below the nav, so the whole photo fits on laptops */
  @media (min-width: 901px) {
    .photo {
      max-height: calc(100svh - var(--header-height) - 48px);
    }
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-width: 0;
  }

  .body h2 {
    font-size: 56px;
    line-height: 0.95;
  }

  .body p {
    max-width: 52ch;
    color: var(--cream-muted);
  }

  .body .lead {
    font-size: 20px;
    max-width: 46ch;
    color: var(--cream);
  }

  .cv {
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .cv:hover {
    color: var(--amber);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
