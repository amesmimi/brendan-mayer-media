---
import { site } from '../data/site';
import { url } from '../lib/paths';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const link = (hash: string) => (isHome ? hash : url(hash));
---

<footer class="site-footer wrap">
  <div class="footer-inner">
    <a class="footer-mark" href={url()}>
      Brendan Mayer <span>Media</span>
    </a>
    <div class="footer-social">
      <a class="icon-btn" href={site.instagram.url} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
        </svg>
      </a>
      <a class="icon-btn" href={link('#contact')} aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
      </a>
    </div>
    <p class="legal">
      {`© ${site.copyrightYear} ${site.photographer}.`} All photographs are protected by copyright and may not be
      copied, downloaded or reused without written permission.{' '}
      <a href={link('#contact')}>Licensing enquiries welcome.</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(72px, 9vw, 120px);
    padding-bottom: max(40px, env(safe-area-inset-bottom, 0px));
    text-align: center;
  }

  .footer-inner {
    display: grid;
    justify-items: center;
    gap: 22px;
    border-top: 1px solid var(--line);
    padding-top: 56px;
  }

  .footer-mark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 6vw, 64px);
    text-transform: uppercase;
    line-height: 0.9;
    text-decoration: none;
  }

  .footer-mark span {
    color: var(--amber);
  }

  .footer-social {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .legal {
    font-size: 14px;
    color: var(--cream-muted);
    max-width: 60ch;
  }
</style>
