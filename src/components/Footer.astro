---
import { site } from '../data/site';
---

<footer class="site-footer wrap">
  <p>{`© ${site.copyrightYear} ${site.photographer}.`}</p>
</footer>

<style>
  .site-footer {
    padding-top: 22px;
    padding-bottom: max(28px, env(safe-area-inset-bottom, 0px));
    font-size: 13px;
    color: var(--cream-muted);
    text-align: center;
  }
</style>
