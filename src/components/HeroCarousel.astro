---
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/galleries';
import { PHOTO_QUALITY, widthsFor } from '../lib/images';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<!--
  Edge-to-edge slideshow with nothing over the photos: a slow crossfade and gentle zoom.
  On phones the header is taller than it is wide, so each photo is shown wider than the screen (sides cropped off);
  the 750px size hint makes phones load a file big enough for that instead of one sized to the screen width.
-->
<section class="hero protect" aria-label="Featured photographs" data-hero>
  {photos.map((photo, i) => (
    <figure
      class:list={[
        'slide',
        photo.heroY !== undefined ? `y-${photo.heroY}` : photo.focus && `focus-${photo.focus}`,
        photo.heroX !== undefined && `hx-${photo.heroX}`,
        { 'is-active': i === 0 },
      ]}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <Picture
        src={photo.image}
        alt={photo.alt}
        formats={['avif', 'webp']}
        widths={widthsFor(photo.image, [800, 1200, 1600, 2000, 2400, 2800, 3200])}
        quality={PHOTO_QUALITY}
        sizes="(max-width: 750px) 750px, 100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    </figure>
  ))}
</section>

<style>
  /*
   * Sized by width, but never taller than the screen below the top bar minus a strip, so on laptops the whole photo
   * is in view and the top of the intro line peeks in underneath as a cue to scroll.
   */
  .hero {
    position: relative;
    height: clamp(420px, min(56vw, calc(100svh - var(--header-height) - 40px)), 820px);
    overflow: hidden;
    background: var(--charcoal-950);
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hx, 50%) var(--hy, 50%);
    transform-origin: var(--hx, 50%) var(--hy, 50%);
  }

  /* Photos marked `focus: top` (or bottom) in the gallery files are anchored there when cropped */
  .slide.focus-top {
    --hy: 12%;
  }

  .slide.focus-bottom {
    --hy: 88%;
  }

  /* Finer framing from a photo's `heroY` (classes, since the security policy blocks inline styles) */
  .slide.y-0 {
    --hy: 0%;
  }
  .slide.y-5 {
    --hy: 5%;
  }
  .slide.y-10 {
    --hy: 10%;
  }
  .slide.y-15 {
    --hy: 15%;
  }
  .slide.y-20 {
    --hy: 20%;
  }
  .slide.y-25 {
    --hy: 25%;
  }
  .slide.y-30 {
    --hy: 30%;
  }
  .slide.y-35 {
    --hy: 35%;
  }
  .slide.y-40 {
    --hy: 40%;
  }
  .slide.y-45 {
    --hy: 45%;
  }
  .slide.y-50 {
    --hy: 50%;
  }
  .slide.y-55 {
    --hy: 55%;
  }
  .slide.y-60 {
    --hy: 60%;
  }
  .slide.y-65 {
    --hy: 65%;
  }
  .slide.y-70 {
    --hy: 70%;
  }
  .slide.y-75 {
    --hy: 75%;
  }
  .slide.y-80 {
    --hy: 80%;
  }
  .slide.y-85 {
    --hy: 85%;
  }
  .slide.y-90 {
    --hy: 90%;
  }
  .slide.y-95 {
    --hy: 95%;
  }
  .slide.y-100 {
    --hy: 100%;
  }

  /* Phones only, where the sides are cropped off: a photo's `heroX` sets how far across to frame it */
  @media (max-width: 750px) {
    .slide.hx-0 {
      --hx: 0%;
    }
    .slide.hx-5 {
      --hx: 5%;
    }
    .slide.hx-10 {
      --hx: 10%;
    }
    .slide.hx-15 {
      --hx: 15%;
    }
    .slide.hx-20 {
      --hx: 20%;
    }
    .slide.hx-25 {
      --hx: 25%;
    }
    .slide.hx-30 {
      --hx: 30%;
    }
    .slide.hx-35 {
      --hx: 35%;
    }
    .slide.hx-40 {
      --hx: 40%;
    }
    .slide.hx-45 {
      --hx: 45%;
    }
    .slide.hx-50 {
      --hx: 50%;
    }
    .slide.hx-55 {
      --hx: 55%;
    }
    .slide.hx-60 {
      --hx: 60%;
    }
    .slide.hx-65 {
      --hx: 65%;
    }
    .slide.hx-70 {
      --hx: 70%;
    }
    .slide.hx-75 {
      --hx: 75%;
    }
    .slide.hx-80 {
      --hx: 80%;
    }
    .slide.hx-85 {
      --hx: 85%;
    }
    .slide.hx-90 {
      --hx: 90%;
    }
    .slide.hx-95 {
      --hx: 95%;
    }
    .slide.hx-100 {
      --hx: 100%;
    }
  }

  /* The outgoing slide keeps its zoom while it fades out, so it doesn't snap back to full size. */
  .slide.is-active :global(img),
  .slide.is-leaving :global(img) {
    animation: kenburns 7s linear forwards;
  }

  /* Held still for reduced-motion visitors, or while scrolled out of view */
  .hero.paused .slide.is-active :global(img),
  .hero.offscreen .slide.is-active :global(img) {
    animation-play-state: paused;
  }

  /* A gentle 4% push-in: enough to feel alive, small enough that photos stay crisp and barely more cropped */
  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.04);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SLIDE_MS = 6500;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.slide')];
    let current = 0;
    if (slides.length < 2) return;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        if (!on && s.classList.contains('is-active')) s.classList.add('is-leaving');
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
    };

    // Once an outgoing slide has faded out, drop its zoom.
    slides.forEach((s) =>
      s.addEventListener('transitionend', (e) => {
        if (e.target === s && e.propertyName === 'opacity' && !s.classList.contains('is-active')) {
          s.classList.remove('is-leaving');
        }
      }),
    );

    let timer = 0;
    const start = () => (timer ||= window.setInterval(() => show(current + 1), SLIDE_MS));
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    // There's no pause button, so people who prefer reduced motion get a still header (the first photo).
    hero.classList.toggle('paused', reduceMotion);
    if (reduceMotion) return;

    // Hold the slideshow while it's scrolled out of view, so visitors come back to where they left it.
    new IntersectionObserver(([entry]) => {
      hero.classList.toggle('offscreen', !entry.isIntersecting);
      if (entry.isIntersecting) start();
      else stop();
    }).observe(hero);
  });
</script>
