---
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/galleries';
import { widthsFor } from '../lib/images';
import { site } from '../data/site';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<section class="hero wrap" aria-label="Featured photographs">
  <div class="stage protect" data-hero>
    <div class="slides">
      {photos.map((photo, i) => (
        <figure
          class:list={['slide', photo.focus && `focus-${photo.focus}`, { 'is-active': i === 0 }]}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <Picture
            src={photo.image}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={widthsFor(photo.image, [800, 1200, 1600, 2000, 2400])}
            sizes="(min-width: 1440px) 1344px, calc(100vw - 32px)"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            draggable="false"
          />
        </figure>
      ))}
    </div>

    <div class="hero-copy">
      <h1>
        Brendan Mayer <span class="media">Media</span>
      </h1>
      <p>{site.tagline}</p>
    </div>

    <div class="hero-bar">
      <p class="hero-caption">
        {photos.map((photo, i) => (
          <span data-caption hidden={i !== 0}>
            <b>{photo.galleryLabel}</b> · {photo.title}
          </span>
        ))}
      </p>
      {/* Progress indicator only. The header sets the scene; visitors browse photos in What I shoot below. */}
      <div class="segs" aria-hidden="true">
        {photos.map((_, i) => (
          <span class:list={['seg', { 'is-active': i === 0 }]}>
            <i />
          </span>
        ))}
      </div>
      {/* Pause stays: anything that moves on its own for over 5s needs a way to stop it (WCAG 2.2.2). */}
      <button class="icon-btn" type="button" data-pause aria-pressed="false" aria-label="Pause slideshow">
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1"></rect>
        </svg>
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5l11 7-11 7z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 16px;
  }

  /* Copy and controls sit in normal flow at the bottom, so the headline can't be pushed off the top. */
  .stage {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--charcoal-950);
    min-height: clamp(540px, 78vh, 820px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(28px, 4vh, 48px);
    padding: clamp(96px, 12vh, 140px) clamp(20px, 4vw, 56px) clamp(20px, 3vw, 32px);
  }

  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Charcoal shade, so red and blue stage light stay true */
    background:
      linear-gradient(180deg, rgb(18 17 16 / 0) 35%, rgb(18 17 16 / 0.5) 65%, rgb(18 17 16 / 0.88) 100%),
      linear-gradient(90deg, rgb(18 17 16 / 0.4) 0%, rgb(18 17 16 / 0) 55%);
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 60% 40%;
  }

  /* Photos marked `focus: top` (or bottom) in the captions file are anchored there when cropped */
  .slide.focus-top :global(img) {
    object-position: 50% 12%;
    transform-origin: 50% 12%;
  }

  .slide.focus-bottom :global(img) {
    object-position: 50% 88%;
    transform-origin: 50% 88%;
  }

  /* The outgoing slide keeps its zoom while it fades out, so it doesn't snap back to full size. */
  .slide.is-active :global(img),
  .slide.is-leaving :global(img) {
    animation: kenburns 7s linear forwards;
  }

  /* Paused by the visitor, or scrolled out of view */
  .stage.paused .slide.is-active :global(img),
  .stage.paused .seg.is-active i,
  .stage.offscreen .slide.is-active :global(img),
  .stage.offscreen .seg.is-active i {
    animation-play-state: paused;
  }

  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 20px;
    max-width: 980px;
    min-width: 0;
  }

  h1 {
    font-size: clamp(56px, 7.5vw, 120px);
    font-weight: 900;
    line-height: 0.86;
  }

  .media {
    display: block;
    color: transparent;
    -webkit-text-stroke: 2px var(--amber);
  }

  .hero-copy p {
    font-size: clamp(17px, 1.6vw, 21px);
    max-width: 34ch;
  }

  .hero-bar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-caption {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--cream-muted);
    flex: 1 1 260px;
    min-width: 0;
  }

  .hero-caption b {
    color: var(--cream);
    font-weight: 500;
  }

  .segs {
    display: flex;
    gap: 6px;
    flex: 0 1 220px;
    min-width: 120px;
  }

  .seg {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: rgb(230 224 215 / 0.25);
    position: relative;
    overflow: hidden;
  }

  .seg i {
    position: absolute;
    inset: 0;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
  }

  .seg.done i {
    transform: scaleX(1);
  }

  .seg.is-active i {
    animation: fill var(--slide-duration) linear forwards;
  }

  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }

  /* The progress bar times each slide, so it keeps its full length when the global reduced-motion rule
     shortens animations. Otherwise pressing Play would flip through slides as fast as the screen redraws. */
  @media (prefers-reduced-motion: reduce) {
    .seg.is-active i {
      animation-duration: var(--slide-duration) !important;
    }
  }

  .icon-play,
  .paused .icon-pause {
    display: none;
  }

  .paused .icon-play {
    display: block;
  }

  @media (max-width: 640px) {
    .stage {
      min-height: clamp(560px, 84vh, 760px);
    }
    .media {
      -webkit-text-stroke-width: 1.5px;
    }
    .hero-caption {
      flex-basis: 100%;
      order: 2;
    }
    /* Bars fill the row so the pause button lines up with the right edge */
    .segs {
      flex: 1 1 auto;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((stage) => {
    const slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
    const segs = [...stage.querySelectorAll<HTMLElement>('.seg')];
    const captions = [...stage.querySelectorAll<HTMLElement>('[data-caption]')];
    const pauseButton = stage.querySelector<HTMLButtonElement>('[data-pause]')!;
    let current = 0;
    let paused = false;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        if (!on && s.classList.contains('is-active')) s.classList.add('is-leaving');
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
      captions.forEach((c, i) => (c.hidden = i !== current));
      segs.forEach((s, i) => {
        s.classList.remove('is-active');
        s.classList.toggle('done', i < current);
      });
      const seg = segs[current];
      void seg.offsetWidth; // restart the progress animation
      seg.classList.add('is-active');
    };

    const setPaused = (value: boolean) => {
      paused = value;
      stage.classList.toggle('paused', value);
      pauseButton.setAttribute('aria-pressed', String(value));
      pauseButton.setAttribute('aria-label', value ? 'Play slideshow' : 'Pause slideshow');
    };

    // Once an outgoing slide has faded out, drop its zoom.
    slides.forEach((s) =>
      s.addEventListener('transitionend', (e) => {
        if (e.target === s && e.propertyName === 'opacity' && !s.classList.contains('is-active')) {
          s.classList.remove('is-leaving');
        }
      }),
    );

    segs.forEach((seg, i) => {
      seg.querySelector('i')?.addEventListener('animationend', () => {
        if (i === current && !paused && !stage.classList.contains('offscreen')) show(current + 1);
      });
    });
    pauseButton.addEventListener('click', () => setPaused(!paused));

    // Hold the slideshow while it's scrolled out of view, so visitors come back to where they left it.
    // Kept separate from the visitor's own pause, so scrolling back never overrides their choice.
    new IntersectionObserver(([entry]) => stage.classList.toggle('offscreen', !entry.isIntersecting)).observe(stage);

    // Don't auto-advance for people who prefer reduced motion.
    setPaused(reduceMotion);
  });
</script>
