---
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/galleries';
import { PHOTO_QUALITY, widthsFor } from '../lib/images';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<!-- Edge-to-edge slideshow with nothing over the photos: a slow crossfade and gentle zoom. -->
<section class="hero protect" aria-label="Featured photographs" data-hero>
  {photos.map((photo, i) => (
    <figure
      class:list={['slide', photo.focus && `focus-${photo.focus}`, { 'is-active': i === 0 }]}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <Picture
        src={photo.image}
        alt={photo.alt}
        formats={['avif', 'webp']}
        widths={widthsFor(photo.image, [800, 1200, 1600, 2000, 2400, 2800, 3200])}
        quality={PHOTO_QUALITY}
        sizes="100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    </figure>
  ))}
</section>

<style>
  .hero {
    position: relative;
    height: clamp(420px, 56vw, 820px);
    overflow: hidden;
    background: var(--charcoal-950);
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Photos marked `focus: top` (or bottom) in the captions file are anchored there when cropped */
  .slide.focus-top :global(img) {
    object-position: 50% 12%;
    transform-origin: 50% 12%;
  }

  .slide.focus-bottom :global(img) {
    object-position: 50% 88%;
    transform-origin: 50% 88%;
  }

  /* The outgoing slide keeps its zoom while it fades out, so it doesn't snap back to full size. */
  .slide.is-active :global(img),
  .slide.is-leaving :global(img) {
    animation: kenburns 7s linear forwards;
  }

  /* Held still for reduced-motion visitors, or while scrolled out of view */
  .hero.paused .slide.is-active :global(img),
  .hero.offscreen .slide.is-active :global(img) {
    animation-play-state: paused;
  }

  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SLIDE_MS = 6500;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.slide')];
    let current = 0;
    if (slides.length < 2) return;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        if (!on && s.classList.contains('is-active')) s.classList.add('is-leaving');
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
    };

    // Once an outgoing slide has faded out, drop its zoom.
    slides.forEach((s) =>
      s.addEventListener('transitionend', (e) => {
        if (e.target === s && e.propertyName === 'opacity' && !s.classList.contains('is-active')) {
          s.classList.remove('is-leaving');
        }
      }),
    );

    // There's no pause button, so people who prefer reduced motion get a still header (the first photo).
    hero.classList.toggle('paused', reduceMotion);
    if (reduceMotion) return;

    // Hold the slideshow while it's scrolled out of view, so visitors come back to where they left it.
    let timer = 0;
    const start = () => (timer ||= window.setInterval(() => show(current + 1), SLIDE_MS));
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([entry]) => {
      hero.classList.toggle('offscreen', !entry.isIntersecting);
      if (entry.isIntersecting) start();
      else stop();
    }).observe(hero);
  });
</script>
