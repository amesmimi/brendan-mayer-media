---
import { getNavItems } from '../lib/nav';
import { url } from '../lib/paths';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const link = (hash: string) => (isHome ? hash : url(hash));
const items = getNavItems(isHome);
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Main">
    <a class="wordmark" href={url()}>
      Brendan Mayer <span>Media</span>
    </a>
    <ul class="nav-links">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a class="btn btn-primary book" href={link('#contact')}>
        Book a shoot
      </a>
      <details class="mobile-menu" data-mobile-menu>
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: rgb(8 32 29 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--header-height);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark span {
    color: var(--amber);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-small);
    color: var(--cream-muted);
  }

  .nav-links a:hover {
    color: var(--cream);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .book {
    min-height: 42px;
    padding: 0 18px;
    font-size: var(--text-small);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    width: 42px;
    height: 42px;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 200px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--green-950);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
  }

  .mobile-menu a {
    display: block;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 500;
  }

  .mobile-menu a:hover {
    background: var(--green-700);
  }

  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .wordmark {
      font-size: 22px;
    }
  }

  @media (max-width: 400px) {
    .wordmark {
      font-size: 19px;
    }
    .book {
      padding: 0 14px;
    }
  }
</style>
