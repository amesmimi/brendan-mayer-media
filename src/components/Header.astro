---
import { getNavItems } from '../lib/nav';
import { url } from '../lib/paths';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const link = (hash: string) => (isHome ? hash : url(hash));
const items = getNavItems(isHome);
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Main">
    <a class="wordmark" href={url()}>
      Brendan Mayer <span>Media</span>
    </a>
    <ul class="nav-links">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
      <li>
        <a class="book" href={link('#contact')}>
          Book a shoot
        </a>
      </li>
    </ul>
    <div class="nav-actions">
      <a class="book" href={link('#contact')}>
        Book a shoot
      </a>
      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Plain text bar on the page background: the photos below do the talking */
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: var(--charcoal);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    min-height: var(--header-height);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark span {
    color: var(--amber);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .nav-links a,
  .mobile-menu a {
    text-decoration: none;
    text-underline-offset: 6px;
  }

  .nav-links a:hover,
  .mobile-menu a:hover {
    color: var(--amber);
  }

  .book {
    color: var(--amber);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    white-space: nowrap;
  }

  .book:hover {
    color: var(--amber-hover);
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 20px;
  }

  .mobile-menu {
    position: relative;
  }

  /* Three-line menu icon, with a full-size tap target */
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .mobile-menu summary svg {
    width: 24px;
    height: 24px;
  }

  .mobile-menu summary:hover {
    color: var(--amber);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu ul {
    position: absolute;
    right: 0;
    top: 100%;
    min-width: 180px;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    background: var(--charcoal-950);
    border: 1px solid var(--line);
  }

  .mobile-menu a {
    display: block;
    padding: 12px 18px;
    font-weight: 500;
  }

  /* Six links need about 960px; below that they move into the menu */
  @media (max-width: 980px) {
    .nav-links {
      display: none;
    }
    .nav-actions {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .wordmark {
      font-size: 26px;
    }
  }

  @media (max-width: 400px) {
    .wordmark {
      font-size: 22px;
    }
    .nav-actions {
      gap: 14px;
    }
  }
</style>
