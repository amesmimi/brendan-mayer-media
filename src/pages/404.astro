---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
---

<BaseLayout title="Page not found">
  <section class="wrap missing" aria-labelledby="missing-title">
    <h1 id="missing-title">Missed the shot</h1>
    <p>This page doesn't exist. It may have moved, or the link may have a typo.</p>
    <div class="links">
      <a href={url()}>Back to the homepage</a>
      <a href={url('#services')}>See the work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .missing {
    padding-block: clamp(80px, 14vw, 180px) clamp(96px, 10vw, 128px);
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(64px, 12vw, 160px);
    font-weight: 900;
    line-height: 0.86;
  }

  p {
    color: var(--cream-muted);
    max-width: 48ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-weight: 600;
  }

  .links a {
    text-underline-offset: 5px;
  }

  .links a:hover {
    color: var(--amber);
  }
</style>
