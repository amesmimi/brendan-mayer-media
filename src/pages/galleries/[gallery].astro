---
/**
 * The old one-page-per-category gallery addresses, kept so links already shared still work: each forwards to its
 * section of the single Gallery page (e.g. /galleries/sports/ → /gallery/#sports). Concerts and Festivals were
 * merged into Live Music, so both of those go there.
 */
import type { GetStaticPaths } from 'astro';
import { url } from '../../lib/paths';

// Old address → its section now. (Defined inside, since Astro runs getStaticPaths on its own.)
export const getStaticPaths = (() => {
  const OLD_GALLERIES: Record<string, string> = {
    concerts: 'live-music',
    festivals: 'live-music',
    sports: 'sports',
    events: 'events',
  };
  return Object.entries(OLD_GALLERIES).map(([gallery, slug]) => ({ params: { gallery }, props: { slug } }));
}) satisfies GetStaticPaths;

const target = url(`gallery/#${Astro.props.slug}`);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(url('gallery/'), Astro.site).href} />
    <title>Moved to the gallery</title>
  </head>
  <body>
    <p>
      This gallery has moved. <a href={target}>See it in the gallery</a>.
    </p>
  </body>
</html>
