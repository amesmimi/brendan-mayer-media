---
/**
 * The old one-page-per-category gallery addresses, kept so links already shared still work:
 * each forwards to its section of the single Gallery page (e.g. /galleries/sports/ → /gallery/#sports).
 */
import type { GetStaticPaths } from 'astro';
import { getGalleries } from '../../lib/galleries';
import { url } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({ params: { gallery: gallery.slug }, props: { slug: gallery.slug } }));
}) satisfies GetStaticPaths;

const target = url(`gallery/#${Astro.props.slug}`);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(url('gallery/'), Astro.site).href} />
    <title>Moved to the gallery</title>
  </head>
  <body>
    <p>
      This gallery has moved. <a href={target}>See it in the gallery</a>.
    </p>
  </body>
</html>
